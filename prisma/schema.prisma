generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  ADMIN
  NUCLEO
  PADRINHO
  VISITANTE
}

enum Nucleo {
  ADMINISTRATIVO_FINANCEIRO
  PROJETOS_CAPTACAO
  JURIDICO_SOCIAL
  TECNOLOGIA_COMUNICACAO
  ESPORTE_LAZER
  PEDAGOGICO
  SAUDE_MEIO_AMBIENTE
  APOIO_INFRAESTRUTURA
  APADRINHAMENTO
}

enum Sala {
  ROSA
  AMARELA
  VERDE
  AZUL
  CIRANDA_MUNDO
}

enum StatusTarefa {
  CRIADA
  EM_ANDAMENTO
  CONCLUIDA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

enum NivelAlfabetizacao {
  PRE_SILABICO
  SILABICO_SEM_VALOR
  SILABICO_COM_VALOR
  SILABICO_ALFABETICO
  ALFABETICO_INICIAL
  ALFABETICO_FINAL
  ALFABETICO_ORTOGRAFICO
}

enum EtapaAvaliacao {
  PRIMEIRA
  SEGUNDA
  FINAL
}

enum NivelMare {
  BAIXA
  VAZANTE
  ENCHENTE
  ALTA
  CHEIA
}

enum Recorrencia {
  NENHUMA
  MENSAL
}

model Usuario {
  id            String    @id @default(cuid())
  nome          String
  email         String    @unique
  senhaHash     String
  papel         Papel     @default(NUCLEO)
  nucleo        Nucleo?
  tentativasFalhas Int    @default(0)
  bloqueadoAte  DateTime?
  criadoEm      DateTime  @default(now())

  postagens     Postagem[]
  tarefasCriadas Tarefa[]
  lembretes     Lembrete[]
  solicitacoesEnviadas Solicitacao[] @relation("solicitacoesEnviadas")
  links         LinkNucleo[]
  cirandas      Ciranda[]
  eventosCalendario EventoCalendario[]
}

model Aluno {
  id           String   @id @default(cuid())
  nome         String
  idade        Int?
  comunidade   String?
  turma        String?
  sala         Sala
  padrinho     String?
  criadoEm     DateTime @default(now())

  matriculaTurnoEstendido MatriculaTurnoEstendido?
  avaliacoesMare  AvaliacaoMare[]
  avaliacoesAlfabetizacao AvaliacaoAlfabetizacao[]
}

model MatriculaTurnoEstendido {
  id        String   @id @default(cuid())
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId   String   @unique
  criadoEm  DateTime @default(now())
}

model AvaliacaoAlfabetizacao {
  id          String             @id @default(cuid())
  aluno       Aluno              @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId     String
  ano         Int
  etapa       EtapaAvaliacao
  nivel       NivelAlfabetizacao
  evidencias  String[]
  observacoes String?
  criadoEm    DateTime           @default(now())

  @@unique([alunoId, ano, etapa])
}

model AvaliacaoMare {
  id             String    @id @default(cuid())
  aluno          Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId        String
  semestre       String
  notas          Json
  observacoes    String?
  criadoEm       DateTime  @default(now())

  @@unique([alunoId, semestre])
}

model Postagem {
  id        String   @id @default(cuid())
  nucleo    Nucleo?
  texto     String
  imagemUrl String?
  publica   Boolean  @default(false)
  autor     Usuario  @relation(fields: [autorId], references: [id])
  autorId   String
  criadoEm  DateTime @default(now())
}

model Tarefa {
  id          String       @id @default(cuid())
  nucleo      Nucleo
  titulo      String
  descricao   String?
  status      StatusTarefa @default(CRIADA)
  prioridade  Prioridade   @default(MEDIA)
  publica     Boolean      @default(false)
  prazo       DateTime?
  recorrencia Recorrencia  @default(NENHUMA)
  diaRecorrencia Int?
  anexos      String[]     @default([])
  ultimoVencimentoNotificado String?
  autor       Usuario      @relation(fields: [autorId], references: [id])
  autorId     String
  criadoEm    DateTime     @default(now())
}

model Lembrete {
  id           String   @id @default(cuid())
  nucleo       Nucleo
  titulo       String
  descricao    String?
  proximaData  DateTime
  publica      Boolean  @default(false)
  autor        Usuario  @relation(fields: [autorId], references: [id])
  autorId      String
  criadoEm     DateTime @default(now())
}

model LinkNucleo {
  id        String   @id @default(cuid())
  nucleo    Nucleo
  titulo    String
  url       String
  publico   Boolean  @default(false)
  autor     Usuario  @relation(fields: [autorId], references: [id])
  autorId   String
  criadoEm  DateTime @default(now())
}

model Solicitacao {
  id           String   @id @default(cuid())
  nucleoDestino Nucleo?
  assunto      String
  mensagem     String?
  publica      Boolean  @default(false)
  de           Usuario  @relation("solicitacoesEnviadas", fields: [deId], references: [id])
  deId         String
  criadoEm     DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  nucleo    Nucleo?
  papel     Papel?
  criadoEm  DateTime @default(now())
}

model Ciranda {
  id             String   @id @default(cuid())
  semana         String
  tema           String
  desenvolvimento String
  anexos         String[] @default([])
  autor          Usuario  @relation(fields: [autorId], references: [id])
  autorId        String
  criadoEm       DateTime @default(now())
}

model EventoCalendario {
  id        String   @id @default(cuid())
  titulo    String
  descricao String?
  data      DateTime
  autor     Usuario  @relation(fields: [autorId], references: [id])
  autorId   String
  criadoEm  DateTime @default(now())
}
